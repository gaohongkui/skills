{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaohongkui/skills/index/skills.schema.json",
  "title": "skills.json",
  "description": "Machine-readable catalog of every skill in this repository. Generated by scripts/build-index.mjs.",
  "type": "object",
  "required": ["repository", "install", "skillCount", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "homepage": { "type": "string", "format": "uri" },
    "install": { "type": "string" },
    "skillCount": { "type": "integer", "minimum": 0 },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "version", "category", "path", "skillFile", "raw", "files"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "description": { "type": "string", "maxLength": 1024 },
          "version": { "type": "string" },
          "category": { "enum": ["docs", "code", "data", "design", "ops", "meta", "uncategorised"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "license": { "type": "string" },
          "compatibility": { "type": "string" },
          "path": { "type": "string", "pattern": "^skills/" },
          "skillFile": { "type": "string", "pattern": "SKILL\\.md$" },
          "raw": { "type": "string", "format": "uri" },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
